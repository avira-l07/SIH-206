NODE_ENV=development
HOST=127.0.0.1
PORT=5000
DATABASE_URL=file:./dev.db
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set explicit proxy IP/CIDR ranges only when a trusted reverse proxy is deployed.
TRUST_PROXY=
DISABLE_RATE_LIMITS=false
DISABLE_EXTERNAL_DELIVERY=true
OPENWEATHER_API_KEY=mock_mode_active
# Configure persistent production push keys and a contact URI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
OFFLINE_HUB_SECRET=
ENABLE_DEMO=false
RESET_DEMO_DATA=false

# Required in production; retain this key separately with encrypted database backups.
MFA_ENCRYPTION_KEY=
REQUIRE_OPERATOR_MFA=true
# Email verification/password recovery via Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Exact externally visible HTTPS origin used to validate signed provider callbacks.
TWILIO_WEBHOOK_BASE_URL=
