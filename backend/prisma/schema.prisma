datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            Int                  @id @default(autoincrement())
  name          String
  email         String               @unique
  passwordHash  String
  role          String               @default("CITIZEN") // CITIZEN, VOLUNTEER, ADMIN
  phone         String?
  lat           Float?
  lng           Float?
  trusted       Boolean              @default(false)
  safetyStatus  String               @default("UNKNOWN") // SAFE, NEEDS_HELP, UNKNOWN
  safetyUpdatedAt DateTime?
  createdAt     DateTime             @default(now())
  sosRequests   SOSRequest[]
  hazardReports HazardReport[]
  confirmations HazardConfirmation[]
  civilianAssets CivilianAsset[]
}

model Alert {
  id         Int      @id @default(autoincrement())
  hazardType String   // FLOOD, EARTHQUAKE, FIRE
  severity   String   // WATCH, CRITICAL
  region     String
  lat        Float
  lng        Float
  message    String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model SOSRequest {
  id                       Int      @id @default(autoincrement())
  userId                   Int?
  user                     User?    @relation(fields: [userId], references: [id])
  userName                 String
  userPhone                String?
  lat                      Float
  lng                      Float
  coordsAccuracy           Float?
  capturedAt               DateTime?
  message                  String
  hazardType               String   @default("FLOOD")
  vulnerabilityTags        String   @default("") // comma-separated: infant,elderly,pregnant,dialysis
  priority                 String   @default("NORMAL") // NORMAL, URGENT
  status                   String   @default("PENDING") // PENDING, VERIFIED, EN_ROUTE, ON_SCENE, EVACUATED, HANDED_OVER_TO_MEDICAL, RESOLVED, CANCELLED
  triageTag                String?  // IMMEDIATE, DELAYED, MINOR, DECEASED
  cancelReason             String?
  assignedVolunteerId      Int?
  citizenConfirmedResolved Boolean?
  batteryLevel             Int?
  reportedByProxy          Boolean  @default(false)
  subjectDescription       String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model Shelter {
  id                    Int              @id @default(autoincrement())
  name                  String
  address               String
  lat                   Float
  lng                   Float
  capacity              Int
  currentOccupancy      Int              @default(0)
  waterLitersRemaining  Int?
  waterThreshold        Int              @default(200)
  rationsUnitsRemaining Int?
  rationsThreshold      Int              @default(50)
  waterOk               Boolean          @default(true)
  rationsOk             Boolean          @default(true)
  restroomsOk           Boolean          @default(true)
  powerOk               Boolean          @default(true)
  status                String           @default("GREEN") // GREEN, YELLOW, RED
  contact               String
  active                Boolean          @default(true)
  lastAuditedAt         DateTime         @default(now())
  createdAt             DateTime         @default(now())
  supplies              SupplyRequest[]
  shipments             SupplyShipment[]
  events                ShelterEvent[]
}

model ShelterEvent {
  id               Int      @id @default(autoincrement())
  shelterId        Int
  shelter          Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  deltaOccupancy   Int      @default(0) // e.g. +20 (admitted evacuees), -5 (discharged)
  deltaWaterLiters Int      @default(0) // e.g. -100 (consumed), +500 (tanker delivery)
  deltaRations     Int      @default(0) // e.g. -30 (distributed), +200 (crates received)
  reason           String?  // e.g. "Bus arrival from Sector 4", "Tanker restock"
  operatorName     String   @default("Field Operator")
  idempotencyKey   String?  @unique
  capturedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
}

model HazardReport {
  id                 Int                  @id @default(autoincrement())
  userId             Int?
  user               User?                @relation(fields: [userId], references: [id])
  userName           String
  lat                Float
  lng                Float
  hazardNote         String
  severityBenchmark  String?              // ANKLE, KNEE, WAIST, SUBMERGED
  photoUrl           String?              // Base64 encoded image string
  confidenceTier     String               @default("GREY") // GREY, AMBER, RED, DISPUTED, RESOLVED
  confirmationsCount Int                  @default(0)
  createdAt          DateTime             @default(now())
  confirmations      HazardConfirmation[]
}

model HazardConfirmation {
  id               Int          @id @default(autoincrement())
  hazardReportId   Int
  hazardReport     HazardReport @relation(fields: [hazardReportId], references: [id], onDelete: Cascade)
  confirmingUserId Int
  confirmingUser   User         @relation(fields: [confirmingUserId], references: [id], onDelete: Cascade)
  voteType         String       @default("CONFIRM") // CONFIRM, FALSE, RESOLVED
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@unique([hazardReportId, confirmingUserId])
}

model OfflineSyncLog {
  id         Int       @id @default(autoincrement())
  rawPayload String
  parsedData String    // JSON stringified parsed payload
  sourceNode String    @default("SMS Gateway")
  receivedAt DateTime  @default(now())
  syncedAt   DateTime?
}

model CivilianAsset {
  id          Int      @id @default(autoincrement())
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id])
  ownerName   String
  contact     String
  type        String   // BOAT, VEHICLE_4X4, GENERATOR, MEDICAL, HAM_RADIO
  assetType   String?  // BOAT, TRUCK, FOUR_BY_FOUR, MEDICAL, DRONE_PILOT, GENERATOR, HAM_RADIO
  title       String
  description String
  lat         Float
  lng         Float
  available   Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MissingPerson {
  id               Int      @id @default(autoincrement())
  reportedByName   String
  contactPhone     String
  fullName         String
  age              Int?
  gender           String?
  lastSeenLocation String
  lat              Float?
  lng              Float?
  description      String
  status           String   @default("MISSING") // MISSING, LOCATED, SAFE_AT_SHELTER
  shelterName      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SupplyRequest {
  id                Int              @id @default(autoincrement())
  shelterId         Int
  shelter           Shelter          @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  itemName          String
  quantityNeeded    Int              @default(0)
  quantityFulfilled Int              @default(0)
  unit              String           @default("units")
  status            String           @default("OK") // OK, LOW, CRITICAL
  updatedAt         DateTime         @default(now())
  shipments         SupplyShipment[]
}

model SupplyShipment {
  id               Int            @id @default(autoincrement())
  shelterId        Int
  shelter          Shelter        @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  supplyRequestId  Int?
  supplyRequest    SupplyRequest? @relation(fields: [supplyRequestId], references: [id], onDelete: SetNull)
  itemName         String
  quantityClaimed  Int
  quantityVerified Int
  loggedByUserId   Int?
  receivedAt       DateTime       @default(now())
}

model PhoneRegistration {
  id          Int      @id @default(autoincrement())
  phoneNumber String   @unique
  region      String?
  createdAt   DateTime @default(now())
}

model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  keys      String   // stored as JSON string { p256dh, auth }
  region    String?
  createdAt DateTime @default(now())
}

