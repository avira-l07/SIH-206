# Empty uses the Vite /api and /socket.io proxies during local development.
VITE_API_URL=
VITE_ENABLE_DEMO=false
# Exact named development tunnel hosts only; never set this to true or '*'.
VITE_ALLOWED_HOSTS=

# Optional approved operator SMS gateway; national emergency numbers are not application gateways.
VITE_SMS_GATEWAY_NUMBER=
